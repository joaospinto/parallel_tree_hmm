load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load(
    "@rules_cuda//cuda:defs.bzl",
    "cuda_library",
    "requires_cuda",
)

string_flag(
    name = "precision",
    build_setting_default = "fp64",
    values = [
        "fp32",
        "fp64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "fp32",
    flag_values = {":precision": "fp32"},
)

config_setting(
    name = "macos_fp32",
    constraint_values = ["@platforms//os:osx"],
    flag_values = {":precision": "fp32"},
)

cc_library(
    name = "scalar",
    hdrs = ["include/tree_hmm/scalar.h"],
    defines = select({
        ":fp32": ["TREE_HMM_USE_FLOAT=1"],
        "//conditions:default": [],
    }),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "tree_hmm",
    srcs = ["src/inference.cc"],
    hdrs = [
        "include/tree_hmm/accelerator.h",
        "include/tree_hmm/inference.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":scalar",
        "@bidirectional_tree_rake_compress//:btrc",
    ],
)

cc_test(
    name = "inference_test",
    srcs = ["tests/inference_test.cc"],
    deps = [":tree_hmm"],
)

cc_binary(
    name = "inference_benchmark",
    srcs = ["benchmarks/inference_benchmark.cc"],
    deps = [":tree_hmm"],
)

cc_library(
    name = "tree_hmm_cuda_stub",
    srcs = ["src/cuda_stub.cc"],
    hdrs = [
        "include/tree_hmm/accelerator.h",
        "include/tree_hmm/cuda.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":scalar",
        "@bidirectional_tree_rake_compress//:btrc",
    ],
)

cc_test(
    name = "cuda_stub_test",
    srcs = ["tests/cuda_stub_test.cc"],
    deps = [":tree_hmm_cuda_stub"],
)

cc_test(
    name = "cuda_kernel_emulation_test",
    srcs = [
        "src/cuda_device_algebra.h",
        "tests/cuda_kernel_emulation_test.cc",
    ],
    deps = [
        ":tree_hmm",
        "@bidirectional_tree_rake_compress//:btrc",
    ],
)

cc_test(
    name = "accelerator_path_storage_test",
    srcs = [
        "src/accelerator_path_storage.h",
        "tests/accelerator_path_storage_test.cc",
    ],
    deps = ["@bidirectional_tree_rake_compress//:btrc"],
)

cuda_library(
    name = "tree_hmm_cuda",
    srcs = [
        "src/accelerator_path_storage.h",
        "src/cuda.cu",
    ],
    hdrs = [
        "include/tree_hmm/accelerator.h",
        "include/tree_hmm/cuda.h",
        "src/cuda_device_algebra.h",
    ],
    alwayslink = True,
    copts = [
        "--std=c++20",
        "-lineinfo",
        "-Wno-deprecated-gpu-targets",
    ],
    host_copts = ["-std=c++20"],
    includes = ["include"],
    target_compatible_with = requires_cuda(),
    visibility = ["//visibility:public"],
    deps = [
        ":scalar",
        "@bidirectional_tree_rake_compress//:btrc",
    ],
)

cc_test(
    name = "cuda_test",
    srcs = [
        "tests/accelerator_test.h",
        "tests/cuda_test.cc",
    ],
    tags = [
        "manual",
        "requires-gpu",
    ],
    target_compatible_with = requires_cuda(),
    deps = [
        ":tree_hmm",
        ":tree_hmm_cuda",
    ],
)

cc_library(
    name = "tree_hmm_metal",
    srcs = [
        "src/accelerator_path_storage.h",
        "src/metal.cc",
    ],
    hdrs = [
        "include/tree_hmm/accelerator.h",
        "include/tree_hmm/metal.h",
        "src/metal_kernels.h",
    ],
    copts = [
        "-fobjc-arc",
        "-std=c++20",
        "-x",
        "objective-c++",
        "-Wno-gnu-zero-variadic-macro-arguments",
    ],
    includes = ["include"],
    linkopts = [
        "-framework Foundation",
        "-framework Metal",
    ],
    target_compatible_with = select({
        ":macos_fp32": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":scalar",
        "@bidirectional_tree_rake_compress//:btrc",
    ],
)

cc_test(
    name = "metal_test",
    srcs = [
        "tests/accelerator_test.h",
        "tests/metal_test.cc",
    ],
    target_compatible_with = select({
        ":macos_fp32": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":tree_hmm",
        ":tree_hmm_metal",
    ],
)
